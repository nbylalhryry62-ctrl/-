rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'nbylalhryry62@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 100 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.role is string && (data.role == 'student' || data.role == 'admin') &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidExamResult(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.subjectId is string && (data.subjectId == 'biology' || data.subjectId == 'chemistry' || data.subjectId == 'english') &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 100 &&
             data.level is string && data.level.size() >= 1 && data.level.size() <= 50 &&
             data.score is int && data.score >= 0 && data.score <= 1000 &&
             data.total is int && data.total > 0 && data.total <= 1000 &&
             data.score <= data.total &&
             data.percentage is int && data.percentage >= 0 && data.percentage <= 100 &&
             data.passed is bool &&
             data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 7200 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'email', 'username', 'fullName', 'role', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'username', 'fullName', 'role', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       (incoming().role == 'student' || isAdmin());

      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         (request.auth.uid == userId &&
                          incoming().role == existing().role &&
                          incoming().email == existing().email &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'fullName', 'updatedAt'])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'fullName', 'role', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());

      match /results/{resultId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(resultId) && (request.auth.uid == userId || isAdmin());
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && resource.data.userId == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(resultId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'subjectName', 'level', 'score', 'total', 'percentage', 'passed', 'timeTakenSeconds', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'subjectName', 'level', 'score', 'total', 'percentage', 'passed', 'timeTakenSeconds', 'createdAt']) &&
                         isValidExamResult(incoming());

        allow update: if false;

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(resultId) && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}
